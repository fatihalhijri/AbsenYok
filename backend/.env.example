# ============ APP ============
NODE_ENV=development
PORT=4000
APP_NAME=AbsenYok
APP_TIMEZONE=Asia/Jakarta
# Origin frontend (dipisah koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# ============ DATABASE ============
DATABASE_URL="mysql://absenyok:absenyok_secret@localhost:3306/absenyok"

# ============ JWT ============
# Buat dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=ganti_dengan_string_acak_64_byte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti_dengan_string_acak_64_byte_berbeda
JWT_REFRESH_EXPIRES_IN=7d

# ============ COOKIE ============
COOKIE_SECURE=false            # true di produksi (HTTPS)
COOKIE_DOMAIN=                 # kosongkan untuk host-only cookie

# ============ QR ============
QR_SIGNING_SECRET=ganti_dengan_string_acak_64_byte_lain
QR_KIOSK_INTERVAL_SECONDS=30
QR_PERSONAL_INTERVAL_SECONDS=60

# ============ VALIDASI ABSENSI ============
GEOFENCE_ENABLED=true
GEOFENCE_MAX_ACCURACY_METERS=100
DEVICE_BINDING_ENABLED=true
MIN_CHECKOUT_GAP_MINUTES=5

# ============ RATE LIMIT ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ============ UPLOAD ============
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2

# ============ SEED ============
SEED_DEFAULT_PASSWORD=Admin@12345
